# Copiar este archivo como .env y completar los valores.
# NUNCA subir el .env con contraseñas reales al repositorio (es público).

TZ=America/Argentina/Buenos_Aires

API_SECRET_KEY=

#DATABASE
DATABASE_DRIVER=mysql
DATABASE_HOST=
DATABASE_PORT=3306
DATABASE_NAME=
DATABASE_USER=
DATABASE_PASSWORD=

# S3
AWS_S3_URL=
AWS_S3_KEY=
AWS_S3_SECRET_KEY=
AWS_S3_BUCKET_NAME=

# MAIL (Gmail SMTP) - mails de inscripción y reservas
# La contraseña es una "contraseña de aplicación" de Google: pedirla por privado.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=tpfinalbiblioteca@gmail.com
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=tpfinalbiblioteca@gmail.com
MAIL_FROM_NAME="Biblioteca TUP"
MAIL_BCC_ADDRESS=
